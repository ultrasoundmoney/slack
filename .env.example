# The library accepts credentials through constructors; it never reads .env.
# Posting examples require the Bot User OAuth Token, not either app secret below.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# App-level token for future Socket Mode (connections:write); not used for posting.
SLACK_APP_TOKEN=

# Slack Basic Information > App Credentials (not used by the posting crate).
# Client Secret: OAuth code exchange / refresh in a future OAuth integration.
CLIENT_SECRET=
# Signing Secret: verify incoming HTTP requests in a future interaction handler.
SIGNING_SECRET=
